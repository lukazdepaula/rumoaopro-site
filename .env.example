NEXT_PUBLIC_CONTACT_EMAIL=contato@rumoaopro.com.br
NEXT_PUBLIC_SHOPIFY_URL=https://www.rumoaopro.com.br
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_LOADPRO_WHATSAPP=5519992811078

# Public legal identity displayed in Terms, Privacy and Refund pages.
NEXT_PUBLIC_LEGAL_NAME=RP Comércio e Serviços LTDA
NEXT_PUBLIC_LEGAL_DOCUMENT=CNPJ 07.013.889/0001-90
NEXT_PUBLIC_LEGAL_ADDRESS=Rua José Paulino, 1780, apto 102, Campinas - SP, CEP 13023-102, Brasil

# Checkout database/storage
# mock: no gateway; sandbox: Stripe test keys with no real LoadPro provisioning;
# live: real payments and production provisioning.
CHECKOUT_GATEWAY_MODE=mock
CHECKOUT_DB_DRIVER=sqlite
CHECKOUT_DB_PATH=.data/rumoaopro.sqlite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PRIVATE_FILES_DIR=private-files
SIGNED_DOWNLOAD_SECRET=change-me-download-secret
USD_TO_BRL_RATE=5.50

# Admin
# Legacy fallback only. Remove from production after every admin has an
# individual password and a recovery flow has been tested.
ADMIN_PASSWORD=change-me-admin-password
# Use independent random values with at least 32 bytes for each session secret.
ADMIN_SESSION_SECRET=change-me-admin-session-secret
ADMIN_LOGIN_EMAILS=admin@example.com
ADMIN_EMAILS=admin@example.com

# Admin PWA push notifications. Generate one VAPID pair and keep the private
# key server-only; the NEXT_PUBLIC key is intentionally sent to the browser.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:contato@rumoaopro.com.br

# Customer account
# Required in production. The application fails closed when this value is absent.
CUSTOMER_SESSION_SECRET=change-me-customer-session-secret

# Mercado Pago Pix
MERCADO_PAGO_ACCESS_TOKEN=TEST-your-mercado-pago-access-token
MERCADO_PAGO_WEBHOOK_SECRET=

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_COACHING_MONTHLY_PRICE_ID=price_your_recurring_coaching_price
STRIPE_LOADPRO_FOUNDERS_PRICE_ID=price_your_loadpro_founders_price_id

# LoadPro provisioning (server-only; never expose these values with NEXT_PUBLIC_)
LOADPRO_APP_URL=https://loadpro.rumoaopro.com.br
LOADPRO_SUPABASE_URL=https://your-loadpro-project.supabase.co
LOADPRO_SUPABASE_SERVICE_ROLE_KEY=your-loadpro-service-role-key

# RaptorPro commercial-program provisioning (server-only)
RAPTORPRO_APP_URL=https://app.rumoaopro.com.br
RAPTORPRO_SUPABASE_URL=https://your-raptorpro-project.supabase.co
RAPTORPRO_SUPABASE_SERVICE_ROLE_KEY=your-raptorpro-service-role-key

# Email delivery
# Production requires EMAIL_PROVIDER=resend and a configured RESEND_API_KEY.
EMAIL_PROVIDER=mock
EMAIL_FROM=RumoAoPro <no-reply@rumoaopro.com>
INTERNAL_SALES_EMAIL=contato@rumoaopro.com.br
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=

# Product prices. Adjust before production.
RAP_PROGRAM_PRICE_USD=38.95
RAP_PROGRAM_PRICE_BRL=199.90
LOADPRO_FOUNDERS_PRICE_BRL=49.90
LOADPRO_FOUNDERS_PRICE_USD=9.90
RAP_COACHING_PRICE_BRL=399.00
RAP_COACHING_PRICE_USD=75.00

# Meta Ads measurement. Pixel IDs are public; keep Conversions API tokens
# server-only in the hosting provider. Remove test codes after validation.
NEXT_PUBLIC_RUMOAOPRO_META_PIXEL_ID=
RUMOAOPRO_META_CONVERSIONS_API_TOKEN=
RUMOAOPRO_META_CONVERSIONS_API_TEST_EVENT_CODE=
NEXT_PUBLIC_LOADPRO_META_PIXEL_ID=
LOADPRO_META_CONVERSIONS_API_TOKEN=
LOADPRO_META_CONVERSIONS_API_TEST_EVENT_CODE=

# Legacy LoadPro aliases kept for existing deployments during migration.
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
META_CONVERSIONS_API_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v23.0
